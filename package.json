{
  "name": "@arvist/react",
  "version": "0.1.0",
  "description": "React SDK for the Arvist API — headless hooks and Tailwind components for quality inspection, exception handling, and live station feeds.",
  "license": "BUSL-1.1",
  "author": "Arvist",
  "homepage": "https://github.com/ArvistDev/arvist-react#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ArvistDev/arvist-react.git"
  },
  "bugs": {
    "url": "https://github.com/ArvistDev/arvist-react/issues"
  },
  "keywords": [
    "arvist",
    "react",
    "sdk",
    "warehouse",
    "quality-inspection",
    "wms",
    "tailwind"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js",
      "require": "./dist/core.cjs"
    },
    "./ui": {
      "types": "./dist/ui.d.ts",
      "import": "./dist/ui.js",
      "require": "./dist/ui.cjs"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup && bun run build:css",
    "build:css": "tailwindcss -i ./src/ui/styles.css -o ./dist/styles.css --minify",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext ts,tsx",
    "prepublishOnly": "bun run typecheck && bun run test && bun run build"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.6.0"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "socket.io-client": "^4.7.0"
  },
  "peerDependenciesMeta": {
    "socket.io-client": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/react": "^19.2.0",
    "react": "^19.2.0",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  }
}
