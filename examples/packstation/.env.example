# Leave all of these unset to run against the built-in mock backend.

# Point the example at a real deployment.
VITE_ARVIST_URL=https://arvist.example.com

# API bearer token (authenticates the caller).
VITE_ARVIST_TOKEN=

# Cloudflare Access service token (authenticates the device at the edge).
# Independent of the bearer token — a deployment behind Access needs both.
VITE_CF_ACCESS_CLIENT_ID=
VITE_CF_ACCESS_CLIENT_SECRET=
